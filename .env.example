# ==========================================
# AgentFoundry Environment Configuration
# ==========================================

# ------------------------------------------
# 1. API Keys (Required for Gemini Fallback)
# ------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here  # Optional, usually same as GEMINI_API_KEY

# ------------------------------------------
# 2. Model Backend Selection
# ------------------------------------------
# Options: ollama (recommended for local), gemini (cloud only)
MODEL_BACKEND=ollama

# ------------------------------------------
# 3. Local Model Configuration (Ollama)
# ------------------------------------------
# Base URL for Ollama server
OLLAMA_BASE_URL=http://localhost:11434

# Agent-Specific Models
# Recommended: Llama 3.2 1B for speed, 3B for reasoning
# Suffixes like -q8_0 indicate quantization level
PLANNER_MODEL=llama3.2:1b-instruct-q8_0
WORKER_MODEL=llama3.2:3b-instruct-q4_0
VERIFIER_MODEL=llama3.2:1b-instruct-q8_0

# Fine-Tuned Models (Example)
# PLANNER_MODEL=planner-ft:latest
# WORKER_MODEL=worker-ft:latest

# ------------------------------------------
# 4. Gemini Fallback Configuration
# ------------------------------------------
# Automatically use Gemini if local model fails?
USE_GEMINI_FALLBACK=true
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------
# 5. Application Settings
# ------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------
# 6. Paths (Optional Overrides)
# ------------------------------------------
# RAG_DB_PATH=./rag_db
# MEM0_CHROMA_PATH=./.mem0_chroma

# ------------------------------------------
# 7. MCP Server Configuration (Optional)
# ------------------------------------------
MCP_TRANSPORT=stdio
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
